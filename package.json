{
  "name": "grosbyte",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:contact && npm run test:seo",
    "test:contact": "node tests/contact-api.test.mjs",
    "test:seo": "node tests/seo-metadata.test.mjs",
    "test:seo:snapshot": "node tests/visual/seo-snapshot.mjs",
    "test:seo:snapshot:update": "node tests/visual/seo-snapshot.mjs --update",
    "test:visual:baseline": "node tests/visual/capture.mjs --baseline",
    "test:visual:current": "node tests/visual/capture.mjs",
    "test:visual:compare": "node tests/visual/compare.mjs",
    "format": "prettier --write src package.json tsconfig.json next.config.ts eslint.config.mjs postcss.config.mjs",
    "format:check": "prettier --check src package.json tsconfig.json next.config.ts eslint.config.mjs postcss.config.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.33.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
